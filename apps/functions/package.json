{
  "name": "@itsm3/functions",
  "version": "0.0.1",
  "description": "Azure Durable Functions: AI agent orchestrator + P1 escalation",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@azure/communication-call-automation": "^1.3.0",
    "@azure/communication-sms": "^1.1.0",
    "@azure/identity": "^4.4.0",
    "@itsm3/ai-prompts": "workspace:*",
    "@itsm3/graph-client": "workspace:*",
    "fastify": "^5.0.0",
    "@fastify/sensible": "^6.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "rimraf": "^5.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
