{
  "name": "itsm3",
  "private": true,
  "version": "0.0.1",
  "description": "VGC ITSM - Enterprise multi-tenant ITSM for Singapore SMEs",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
