# ─── VGC ITSM-1 Environment Variables ─────────────────────────────────

# Server
PORT=8080

# ─── Database (MySQL — Azure Flexible Server) ────────────────────────
MYSQL_HOST=vgc-itsm-mysql.mysql.database.azure.com
MYSQL_USER=vgcadmin
MYSQL_PASSWORD=
MYSQL_DATABASE=itsmdb
MYSQL_PORT=3306

# ─── Microsoft Entra ID (SSO) ────────────────────────────────────────
ENTRA_TENANT_ID=3994f368-b34e-4722-a56b-92ac87150f00
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# ─── Azure OpenAI (AI Co-Pilot) ─────────────────────────────────────
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_MODEL=gpt-4o-mini

# ─── CORS Origins ───────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:8080,http://localhost:4173,http://localhost:5173

# ─── Local Admin (RETIRED 2026-05-03) ───────────────────────────────
# The local-admin SHA-256 backdoor login has been retired. Both
# POST /api/auth/local and "Bearer local-hash:<sha>" now unconditionally
# return 410/401. Setting LOCAL_ADMIN_PASSWORD_HASH no longer enables
# anything — the server will log a warning at startup if it's set.
# Use Entra SSO for all authentication.
# LOCAL_ADMIN_PASSWORD_HASH=
# LOCAL_ADMIN_NAME=System Admin
# LOCAL_ADMIN_EMAIL=admin@localhost
